# Copy this file to .env and fill in your real values. Never commit .env itself.

PORT=5000

# MongoDB Atlas connection string (from Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/cardnova?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (add your Vercel URL once deployed)
CLIENT_ORIGIN=http://localhost:5173

# M-Pesa Daraja API (sandbox) — get Consumer Key/Secret from developer.safaricom.co.ke "My Apps"
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Standard published sandbox values — same for every developer, no need to change
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Safaricom must be able to reach this URL over the public internet — an ngrok
# URL while testing locally, your real domain once deployed
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/payments/mpesa/callback
# Keep at 1 while testing in sandbox; set to your real Pro plan price once live
MPESA_TEST_AMOUNT=1
